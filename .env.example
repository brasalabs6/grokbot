# GrokBot environment template — copy to .env.local; never commit credentials.

# Authentication (use a cryptographically random value of at least 32 bytes)
AUTH_SECRET=replace-with-generated-random-secret
AUTH_TRUST_HOST=true

# Restricted internal signup/login. Missing allowlist denies regular accounts.
GROKBOT_ALLOWED_EMAILS=operator@example.com
# Secret invitation code of >=32 random characters. Keep server-side only.
GROKBOT_SIGNUP_KEY=replace-with-long-random-invitation-code
# Guest sessions are disabled by default; do not enable on public previews.
GROKBOT_ENABLE_GUEST=0

# Dedicated PostgreSQL for GrokBot; do not reuse an unrelated app database.
POSTGRES_URL=postgresql://user:password@host:5432/grokbot?sslmode=require

# Builds never run migrations. Run pnpm db:migrate explicitly against the
# dedicated DB (use a direct/session connection for migrations; pooler for Next.js).
# Only enable after migrations, signup, and paired Cloudflare secrets are verified.
FEATURE_AGENT_RUNTIME=0

# Cloudflare staging control plane. Set the full HTTPS origin with trailing slash.
CLOUDFLARE_RUNTIME_URL=https://grokbot-sandbox-runtime-staging.guibelongtovi-a22.workers.dev/
# Must match the secure Cloudflare Worker secret (never a public key).
CONTROL_PLANE_SERVICE_SECRET=replace-with-matching-private-value
RUNTIME_TICKET_SECRET=replace-with-matching-private-value

# Optional inherited chatbot template integrations (not required for agent
# sessions; do not provision these unless you use the legacy chatbot UI).
# AI_GATEWAY_API_KEY=
# BLOB_READ_WRITE_TOKEN=
# REDIS_URL=
